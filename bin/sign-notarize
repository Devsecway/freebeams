#!/usr/bin/env bash
# Sign, notarize and staple the macOS app and DMG for Developer ID distribution.
#
# Runs locally (credentials in your login keychain) and in CI (credentials from
# GitHub secrets as environment variables): see "Credentials" below. Nothing in
# this repository holds a certificate or a key; without credentials the script
# stops before touching the build.
#
# Usage:
#   SIGN_IDENTITY="Developer ID Application: Your Name (TEAMID)" \
#   NOTARY_PROFILE="freebeams-notary" \
#     bin/sign-notarize
#
# Flags / env:
#   SKIP_BUILD=1     reuse releases/darwin/universal/FreeBeams.app instead of rebuilding
#   SKIP_NOTARIZE=1  sign only (fast local check; the app will NOT pass Gatekeeper
#                    on other Macs without notarization)
#
# --- Credentials -------------------------------------------------------------
# Signing identity, either:
#   (a) Local: a "Developer ID Application" certificate in your login keychain,
#       and SIGN_IDENTITY naming it:
#         security find-identity -v -p codesigning     # lists it
#   (b) CI: the certificate as a base64 .p12, imported into a throwaway keychain
#       that is deleted on exit. SIGN_IDENTITY is derived from it when unset:
#         MACOS_CERT_P12_BASE64   base64 of the exported .p12 (certificate + key)
#         MACOS_CERT_PASSWORD     the .p12 export password
#
# Notary credentials, either:
#   (a) An App Store Connect API key (what CI uses; not tied to an Apple ID or 2FA):
#         APPLE_API_KEY_P8_BASE64  base64 of AuthKey_XXXXXXXX.p8
#         APPLE_API_KEY_ID         the Key ID
#         APPLE_API_ISSUER_ID      the Issuer ID (a UUID)
#   (b) A keychain profile saved locally:
#         xcrun notarytool store-credentials "freebeams-notary" \
#           --apple-id "you@example.com" --team-id "TEAMID" --password "app-specific-password"
#         NOTARY_PROFILE=freebeams-notary
#
# Output: releases/FreeBeams-<version>-macOS.dmg, signed, notarized and stapled.
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
APP="$ROOT/releases/darwin/universal/FreeBeams.app"
ENTITLEMENTS="$ROOT/packaging/macos/entitlements.plist"

: "${SKIP_BUILD:=0}"
: "${SKIP_NOTARIZE:=0}"

fail() {
	echo "sign-notarize: $*" >&2
	exit 1
}
need() { # need COMMAND "where it comes from"
	command -v "$1" >/dev/null 2>&1 || fail "'$1' not found ($2)"
}

[ "$(uname -s)" = "Darwin" ] || fail "runs on macOS only (codesign, notarytool)"
need codesign "part of macOS"
need xcrun "Xcode command line tools: xcode-select --install"
need security "part of macOS"
need python3 "used to decode the base64 secrets"
[ -f "$ENTITLEMENTS" ] || fail "$ENTITLEMENTS is missing"

# Everything transient (temp keychain, decoded key, manifest) is registered
# here and removed by one EXIT trap. A second `trap ... EXIT` would silently
# replace the first and leak the keychain and private key onto the runner.
CLEANUP_KEYCHAIN=""
CLEANUP_KEYCHAIN_LIST=""
CLEANUP_FILES=()
cleanup() {
	# Capture the status that triggered the trap first and hand it back at
	# the end: a trap that ends on its own last command would replace the
	# script's exit status and turn a failed signing green in CI.
	local rc=$?
	# No `&&` chains here: under `set -e` a false test would abort the
	# handler and leak the keychain (with the private key inside it).
	if [ ${#CLEANUP_FILES[@]} -gt 0 ]; then
		rm -f "${CLEANUP_FILES[@]}" || true
	fi
	if [ -n "$CLEANUP_KEYCHAIN" ]; then
		# Restore the user's keychain search list before deleting ours, or
		# a dangling entry stays behind on a local run.
		if [ -n "$CLEANUP_KEYCHAIN_LIST" ]; then
			# shellcheck disable=SC2086
			security list-keychains -d user -s $CLEANUP_KEYCHAIN_LIST 2>/dev/null || true
		fi
		security delete-keychain "$CLEANUP_KEYCHAIN" 2>/dev/null || true
	fi
	return $rc
}
trap cleanup EXIT

# Guard required variables with an explicit exit rather than `${VAR:?msg}`: a
# `:?` failure exits the shell without setting `$?`, so the EXIT trap would see
# 0 and report success on a missing credential.
require() { # require VAR_NAME "error message"
	if [ -z "${!1:-}" ]; then
		fail "$2"
	fi
}

# Decode $<VAR_NAME> (base64) to a file. python3 rather than base64(1): the
# decode flag differs between the BSD and GNU tools (-D vs -d).
b64decode() { # b64decode VAR_NAME OUT_PATH
	python3 -I -c 'import base64, os, sys; sys.stdout.buffer.write(base64.b64decode(os.environ[sys.argv[1]]))' \
		"$1" >"$2"
}

# --- 0a. Signing identity ----------------------------------------------------
# With a .p12 in the environment, import it into a throwaway keychain rather
# than the login keychain, so CI never mutates persistent state and the key is
# destroyed when the script exits.
if [ -n "${MACOS_CERT_P12_BASE64:-}" ]; then
	require MACOS_CERT_PASSWORD "set MACOS_CERT_PASSWORD alongside MACOS_CERT_P12_BASE64"
	echo "==> importing the signing certificate into a temporary keychain"
	# Outside the working tree on purpose: a crash between create and cleanup
	# must not leave key material in the checkout.
	KEYCHAIN="$(mktemp -d -t freebeams-kc.XXXXXX)/build-signing.keychain-db"
	KEYCHAIN_PW="$(uuidgen)"
	P12="$(mktemp -t freebeams-cert.XXXXXX)"
	CLEANUP_FILES+=("$P12")

	b64decode MACOS_CERT_P12_BASE64 "$P12"
	security create-keychain -p "$KEYCHAIN_PW" "$KEYCHAIN"
	CLEANUP_KEYCHAIN="$KEYCHAIN"
	# No auto-lock: a long notarization wait must not lock the key mid-run.
	security set-keychain-settings -lut 21600 "$KEYCHAIN"
	security unlock-keychain -p "$KEYCHAIN_PW" "$KEYCHAIN"
	security import "$P12" -k "$KEYCHAIN" -P "$MACOS_CERT_PASSWORD" \
		-T /usr/bin/codesign -T /usr/bin/security -f pkcs12
	# Without this codesign blocks on a GUI "allow access?" prompt that can
	# never be answered on a headless runner.
	security set-key-partition-list -S apple-tool:,apple:,codesign: \
		-s -k "$KEYCHAIN_PW" "$KEYCHAIN" >/dev/null
	# Prepend to the search list so codesign finds the identity, remembering
	# the previous list for cleanup.
	CLEANUP_KEYCHAIN_LIST="$(security list-keychains -d user | tr -d '" ')"
	# shellcheck disable=SC2086
	security list-keychains -d user -s "$KEYCHAIN" $CLEANUP_KEYCHAIN_LIST

	if [ -z "${SIGN_IDENTITY:-}" ]; then
		SIGN_IDENTITY="$(security find-identity -v -p codesigning "$KEYCHAIN" |
			awk -F'"' '/Developer ID Application/{print $2; exit}')"
		[ -n "$SIGN_IDENTITY" ] || fail "no 'Developer ID Application' identity in the imported .p12"
		echo "    derived SIGN_IDENTITY: $SIGN_IDENTITY"
	fi
fi
require SIGN_IDENTITY "set SIGN_IDENTITY to your 'Developer ID Application: ...' identity (or MACOS_CERT_P12_BASE64 to import one)"

# --- 0b. Notary credentials --------------------------------------------------
# Resolved up front so a credential mistake fails in seconds, not after the
# build. NOTARY_ARGS is the authentication flag set passed to notarytool.
NOTARY_ARGS=()
if [ "$SKIP_NOTARIZE" != "1" ]; then
	if [ -n "${APPLE_API_KEY_P8_BASE64:-}" ]; then
		require APPLE_API_KEY_ID "set APPLE_API_KEY_ID alongside APPLE_API_KEY_P8_BASE64"
		require APPLE_API_ISSUER_ID "set APPLE_API_ISSUER_ID alongside APPLE_API_KEY_P8_BASE64"
		API_KEY="$(mktemp -t freebeams-authkey.XXXXXX)"
		CLEANUP_FILES+=("$API_KEY")
		b64decode APPLE_API_KEY_P8_BASE64 "$API_KEY"
		NOTARY_ARGS=(--key "$API_KEY" --key-id "$APPLE_API_KEY_ID" --issuer "$APPLE_API_ISSUER_ID")
		echo "==> notarizing with App Store Connect API key $APPLE_API_KEY_ID"
	elif [ -n "${NOTARY_PROFILE:-}" ]; then
		NOTARY_ARGS=(--keychain-profile "$NOTARY_PROFILE")
		echo "==> notarizing with keychain profile '$NOTARY_PROFILE'"
	else
		fail "no notary credentials: set APPLE_API_KEY_P8_BASE64 + APPLE_API_KEY_ID + APPLE_API_ISSUER_ID, or NOTARY_PROFILE, or SKIP_NOTARIZE=1"
	fi
fi

cd "$ROOT"
V="$("$ROOT/bin/version")"
DMG="$ROOT/releases/FreeBeams-$V-macOS.dmg"

# --- 1. Build ----------------------------------------------------------------
if [ "$SKIP_BUILD" = "1" ]; then
	echo "==> skipping the build (SKIP_BUILD=1)"
else
	echo "==> GOOS=macos bin/gd build"
	GOOS=macos "$ROOT/bin/gd" build
fi
[ -d "$APP" ] || fail "$APP not found"

# --- 2. Sign every nested Mach-O, deepest first ------------------------------
# Hardened runtime + secure timestamp + our entitlements. Inside-out order is
# required: an outer signature is invalidated by re-signing anything nested.
sign_one() {
	codesign --force --options runtime --timestamp \
		--entitlements "$ENTITLEMENTS" \
		--sign "$SIGN_IDENTITY" "$1"
}

echo "==> discovering nested Mach-O binaries"
manifest="$(mktemp -t freebeams-manifest.XXXXXX)"
CLEANUP_FILES+=("$manifest")
while IFS= read -r -d '' f; do
	if file -b "$f" | grep -q "Mach-O"; then
		# Prefix with the slash count so the sort puts the deepest first.
		printf '%s\t%s\0' "$(tr -cd '/' <<<"$f" | wc -c | tr -d ' ')" "$f"
	fi
done < <(find "$APP" -type f -print0) |
	sort -z -t"$(printf '\t')" -k1,1nr >"$manifest"

count=0
while IFS="$(printf '\t')" read -r -d '' _depth f; do
	echo "    sign: ${f#"$ROOT"/}"
	sign_one "$f"
	count=$((count + 1))
done <"$manifest"
echo "    signed $count nested binaries"

# --- 3. Nested framework/bundle wrappers, then the .app itself ---------------
while IFS= read -r -d '' fw; do
	echo "    sign bundle: ${fw#"$ROOT"/}"
	sign_one "$fw"
done < <(find "$APP" -type d \( -name "*.framework" -o -name "*.bundle" \) -print0)

echo "==> signing FreeBeams.app"
sign_one "$APP"

# --- 4. Verify ---------------------------------------------------------------
echo "==> verifying the signature"
codesign --verify --deep --strict --verbose=2 "$APP"
codesign --display --verbose=4 "$APP" 2>&1 | grep -E "Authority|TeamIdentifier|Timestamp|flags" || true

# --- 5. DMG ------------------------------------------------------------------
echo "==> packaging the DMG"
SKIP_BUILD=1 "$ROOT/bin/release-dmg"
[ -f "$DMG" ] || fail "$DMG was not produced"
echo "==> signing the DMG"
codesign --force --timestamp --sign "$SIGN_IDENTITY" "$DMG"

# --- 6. Notarize and staple --------------------------------------------------
if [ "$SKIP_NOTARIZE" = "1" ]; then
	echo "==> skipping notarization (SKIP_NOTARIZE=1)"
	echo "    NOTE: not notarized; Gatekeeper blocks this DMG on other Macs."
else
	echo "==> submitting to the Apple notary service (this can take a few minutes)"
	submit_log="$(mktemp -t freebeams-notary.XXXXXX)"
	CLEANUP_FILES+=("$submit_log")
	xcrun notarytool submit "$DMG" "${NOTARY_ARGS[@]}" --wait 2>&1 | tee "$submit_log"
	if ! grep -q 'status: Accepted' "$submit_log"; then
		# notarytool's exit status does not reliably reflect an Invalid
		# submission; fetch the log that names the rejected files.
		id="$(awk '/^ *id: /{print $2; exit}' "$submit_log")"
		[ -z "$id" ] || xcrun notarytool log "$id" "${NOTARY_ARGS[@]}" || true
		fail "notarization was not accepted"
	fi
	echo "==> stapling the ticket"
	xcrun stapler staple "$DMG"
	# Staple the app too, so a copy dragged out of the DMG is self-contained.
	xcrun stapler staple "$APP"
	echo "==> validating"
	xcrun stapler validate "$DMG"
	spctl --assess --type open --context context:primary-signature --verbose=4 "$DMG" || true
fi

echo
echo "Done: $DMG"
ls -lh "$DMG"

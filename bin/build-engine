#!/usr/bin/env bash
# Build FreeBeams' size-optimised Godot export template for one platform and
# point the export preset at it for the duration of a release build.
#
#   bin/build-engine macos|windows|linux   build (once; cached) and print the template path
#   bin/build-engine --path <platform>     print where the template goes, build nothing
#   bin/build-engine --use <platform>      set custom_template/release of that platform's
#                                          preset(s) to the template (the build scripts do
#                                          this and restore the preset when they exit)
#   bin/build-engine --restore             put graphics/export_presets.cfg back
#
# The template is stock Godot $GODOT_VERSION built from the tagged source with
# packaging/engine/custom.py: optimize=size + full LTO, the classes the app does
# not use left out (packaging/engine/freebeams.build, regenerated by
# packaging/engine/profile.go), unused modules off. Drivers per platform:
#   macos   arm64: Metal (+ OpenGL); x86_64: Vulkan through a static MoltenVK
#           (+ OpenGL); both slices lipo'd into macos.zip like Godot's own
#   windows x86_64 with MSVC: Vulkan + OpenGL (no D3D12/ANGLE fallbacks)
#   linux   x86_64: Vulkan + OpenGL, X11 + Wayland
# AccessKit (screen readers) stays on everywhere, as in the official templates.
#
# Built templates are kept under $ENGINE_CACHE (default ~/.cache/freebeams/engine)
# keyed on everything that goes into them, and copied to releases/engine/.
# STOCK_ENGINE=1 makes the release scripts skip all of this (stock templates).
#
# Needs: git, python3 with scons (pip install scons), and the platform's C++
# toolchain (Xcode command line tools; Visual Studio 2022 C++; gcc/g++, pkg-config).
set -euo pipefail

GODOT_VERSION=4.7.2
GODOT_COMMIT=ed1daf0bf001b61586d9930840f2f1394092c079 # 4.7.2-stable
MOLTENVK_VERSION=v1.4.2
ACCESSKIT_SDK=1 # the source tree's misc/scripts/install_accesskit.py pins the version

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT"
PRESETS=graphics/export_presets.cfg
BACKUP=releases/engine/export_presets.cfg.orig

fail() {
	echo "build-engine: $*" >&2
	exit 1
}
step() { printf '\n==> %s\n' "$*" >&2; }

template_name() { # template_name PLATFORM
	case "$1" in
	macos) echo macos.zip ;;
	windows) echo windows_release_x86_64.exe ;;
	linux) echo linux_release.x86_64 ;;
	*) fail "unknown platform '$1' (macos, windows or linux)" ;;
	esac
}

presets_for() { # presets_for PLATFORM: the preset names the template serves
	case "$1" in
	macos) echo "macOS" ;;
	windows) echo "Windows x86_64" ;;
	linux) echo "Linux x86_64" ;;
	esac
}

# set_template PRESET VALUE: rewrite custom_template/release in the options of
# the named preset (the [preset.N.options] that follows its name="..." line).
set_template() {
	local preset="$1" value="$2" tmp
	tmp="$(mktemp)"
	awk -v name="$preset" -v value="$value" '
		/^\[preset\.[0-9]+\]$/ { inpreset = 0 }
		/^name="/ { inpreset = ($0 == "name=\"" name "\"") }
		inpreset && /^custom_template\/release=/ { print "custom_template/release=\"" value "\""; found = 1; next }
		{ print }
		END { if (!found) exit 3 }
	' "$PRESETS" >"$tmp" || {
		rm -f "$tmp"
		fail "no custom_template/release option for preset '$preset' in $PRESETS"
	}
	cat "$tmp" >"$PRESETS"
	rm -f "$tmp"
}

case "${1:-}" in
--path)
	echo "$ROOT/releases/engine/$(template_name "${2:-}")"
	exit 0
	;;
--use)
	platform="${2:-}"
	file="releases/engine/$(template_name "$platform")"
	[ -f "$file" ] || fail "$file is missing: run bin/build-engine $platform first"
	mkdir -p releases/engine
	[ -f "$BACKUP" ] || cp -f "$PRESETS" "$BACKUP"
	while IFS= read -r p; do
		# Preset paths are relative to the project (graphics/).
		set_template "$p" "../$file"
		echo "build-engine: preset '$p' exports with $file" >&2
	done < <(presets_for "$platform")
	exit 0
	;;
--restore)
	if [ -f "$BACKUP" ]; then
		cp -f "$BACKUP" "$PRESETS"
		rm -f "$BACKUP"
	fi
	exit 0
	;;
macos | windows | linux) platform="$1" ;;
*)
	sed -n '2,12p' "$0" >&2
	exit 2
	;;
esac

name="$(template_name "$platform")"
OUT="releases/engine/$name"
CACHE="${ENGINE_CACHE:-${XDG_CACHE_HOME:-$HOME/.cache}/freebeams/engine}"
command -v cygpath >/dev/null 2>&1 && CACHE="$(cygpath -u "$CACHE")"
SRC="$CACHE/godot-$GODOT_VERSION-stable"

# --- the cache key: every input of the build ---------------------------------
if command -v sha256sum >/dev/null 2>&1; then
	sha() { sha256sum | cut -c1-16; }
else
	sha() { shasum -a 256 | cut -c1-16; }
fi
key="$( {
	echo "$GODOT_COMMIT $MOLTENVK_VERSION $ACCESSKIT_SDK $platform"
	cat "$0" packaging/engine/custom.py packaging/engine/freebeams.build
} | sha)"
CACHED="$CACHE/templates/$key/$name"
if [ -f "$CACHED" ]; then
	step "custom $platform template from the cache ($key)"
	mkdir -p releases/engine
	cp -f "$CACHED" "$OUT"
	echo "$ROOT/$OUT"
	exit 0
fi

# --- tools --------------------------------------------------------------------
py=python3
command -v python3 >/dev/null 2>&1 || py=python
command -v "$py" >/dev/null 2>&1 || fail "python3 not found"
if command -v scons >/dev/null 2>&1; then
	SCONS=(scons)
elif "$py" -c 'import SCons' 2>/dev/null; then
	SCONS=("$py" -m SCons)
else
	fail "scons not found: pip install scons (or uv tool install scons)"
fi
command -v git >/dev/null 2>&1 || fail "git not found"

# --- source ---------------------------------------------------------------------
if [ ! -d "$SRC/.git" ]; then
	step "fetch Godot $GODOT_VERSION-stable"
	mkdir -p "$CACHE"
	git clone -q --depth 1 --branch "$GODOT_VERSION-stable" https://github.com/godotengine/godot.git "$SRC"
fi
head="$(git -C "$SRC" rev-parse HEAD)"
[ "$head" = "$GODOT_COMMIT" ] || fail "$SRC is at $head, want $GODOT_COMMIT ($GODOT_VERSION-stable)"
git -C "$SRC" diff --quiet || fail "$SRC has local changes"

jobs="${ENGINE_JOBS:-$(getconf _NPROCESSORS_ONLN 2>/dev/null || echo "${NUMBER_OF_PROCESSORS:-4}")}"
native_path() { if command -v cygpath >/dev/null 2>&1; then cygpath -w "$1"; else echo "$1"; fi; }
PROFILE="$(native_path "$ROOT/packaging/engine/custom.py")"
BUILD_PROFILE="$(native_path "$ROOT/packaging/engine/freebeams.build")"
scons_build() { # scons_build ARGS...
	step "scons $*"
	(cd "$SRC" && "${SCONS[@]}" -j"$jobs" "profile=$PROFILE" "build_profile=$BUILD_PROFILE" "$@" >&2)
}

# AccessKit's prebuilt static libraries (what the official builds link).
la="${LOCALAPPDATA:-}"
command -v cygpath >/dev/null 2>&1 && [ -n "$la" ] && la="$(cygpath -u "$la")"
if [ ! -d "$SRC/bin/build_deps/accesskit" ] && { [ -z "$la" ] || [ ! -d "$la/Godot/build_deps/accesskit" ]; }; then
	step "AccessKit SDK"
	(cd "$SRC" && "$py" misc/scripts/install_accesskit.py >&2)
fi

mkdir -p "$(dirname "$CACHED")" releases/engine
case "$platform" in
macos)
	[ "$(uname -s)" = Darwin ] || fail "the macOS template builds on macOS"
	MVK="$CACHE/MoltenVK-$MOLTENVK_VERSION"
	if [ ! -f "$MVK/MoltenVK/MoltenVK/static/MoltenVK.xcframework/macos-arm64_x86_64/libMoltenVK.a" ]; then
		step "MoltenVK $MOLTENVK_VERSION (static, for the x86_64 Vulkan driver)"
		mkdir -p "$MVK"
		curl -fsSL "https://github.com/KhronosGroup/MoltenVK/releases/download/$MOLTENVK_VERSION/MoltenVK-macos.tar" | tar -C "$MVK" -xf -
	fi
	scons_build platform=macos arch=arm64 metal=yes vulkan=no angle=no
	scons_build platform=macos arch=x86_64 vulkan=yes use_volk=no angle=no \
		"vulkan_sdk_path=$MVK/MoltenVK/MoltenVK/static/MoltenVK.xcframework"
	stage="$(mktemp -d -t freebeams-engine.XXXXXX)"
	trap 'rm -rf "$stage"' EXIT
	cp -R "$SRC/misc/dist/macos_template.app" "$stage/"
	mkdir -p "$stage/macos_template.app/Contents/MacOS"
	lipo -create "$SRC/bin/godot.macos.template_release.arm64" "$SRC/bin/godot.macos.template_release.x86_64" \
		-output "$stage/macos_template.app/Contents/MacOS/godot_macos_release.universal"
	chmod +x "$stage/macos_template.app/Contents/MacOS/godot_macos_release.universal"
	(cd "$stage" && zip -q -9 -r -y "$CACHED.part" macos_template.app)
	mv -f "$CACHED.part" "$CACHED"
	;;
windows)
	case "$(uname -s)" in
	MINGW* | MSYS* | CYGWIN*) ;;
	*) fail "the Windows template builds on Windows (MSVC)" ;;
	esac
	scons_build platform=windows arch=x86_64 vulkan=yes d3d12=no angle=no
	cp -f "$SRC/bin/godot.windows.template_release.x86_64.exe" "$CACHED"
	;;
linux)
	[ "$(uname -s)" = Linux ] || fail "the Linux template builds on Linux"
	scons_build platform=linuxbsd arch=x86_64 vulkan=yes
	cp -f "$SRC/bin/godot.linuxbsd.template_release.x86_64" "$CACHED"
	strip "$CACHED" 2>/dev/null || true
	;;
esac
cp -f "$CACHED" "$OUT"
ls -l "$OUT" >&2
echo "$ROOT/$OUT"

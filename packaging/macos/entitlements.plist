<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!--
      Hardened-runtime entitlements for Developer ID distribution (bin/sign-notarize
      signs every Mach-O in FreeBeams.app with these; this is not an App Store
      sandbox profile).

      disable-library-validation matches the Godot export preset
      (codesign/entitlements/disable_library_validation=true): Godot sets it because
      GDExtension libraries are usually signed by someone else. FreeBeams's only
      extension is its own darwin_universal.dylib, signed with the same identity, so
      this can be dropped once a notarized build has been tested without it.
    -->
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
</dict>
</plist>

{\pard\li0\fi0\ri0\sb0\sl\sa0 \plain\f1\fntnamaut Verse 1\par
\li0\fi0\ri0\sb0\sl\sa0 \plain\f1\fntnamaut Abide with me!\par
\li0\fi0\ri0\sb0\sl\sa0 \plain\f1\fntnamaut Fast falls the eventide.\par
\li0\fi0\ri0\sb0\sl\sa0 \plain\f1\fntnamaut The darkness deepens;\par
\li0\fi0\ri0\sb0\sl\sa0 \plain\f1\fntnamaut Lord, with me abide!\par
\li0\fi0\ri0\sb0\sl\sa0 \plain\f1\fntnamaut When other helpers fail\par
\li0\fi0\ri0\sb0\sl\sa0 \plain\f1\fntnamaut And comforts flee,\par
\li0\fi0\ri0\sb0\sl\sa0 \plain\f1\fntnamaut Help of the helpless,\par
\li0\fi0\ri0\sb0\sl\sa0 \plain\f1\fntnamaut Oh abide with me! \par
\li0\fi0\ri0\sb0\sl\sa0 \par
\li0\fi0\ri0\sb0\sl\sa0 \plain\f1\fntnamaut Verse 2\par
\li0\fi0\ri0\sb0\sl\sa0 \plain\f1\fntnamaut Swift to its close ebbs out\par
\li0\fi0\ri0\sb0\sl\sa0 \plain\f1\fntnamaut Life's little day.\par
\li0\fi0\ri0\sb0\sl\sa0 \plain\f1\fntnamaut Earth's joys grow dim;\par
\li0\fi0\ri0\sb0\sl\sa0 \plain\f1\fntnamaut Its glories pass away.\par
\li0\fi0\ri0\sb0\sl\sa0 \plain\f1\fntnamaut Change and decay\par
\li0\fi0\ri0\sb0\sl\sa0 \plain\f1\fntnamaut In all around I see;\par
\li0\fi0\ri0\sb0\sl\sa0 \plain\f1\fntnamaut O Thou, who changest not,\par
\li0\fi0\ri0\sb0\sl\sa0 \plain\f1\fntnamaut Abide with me! \par
\li0\fi0\ri0\sb0\sl\sa0 \par
\li0\fi0\ri0\sb0\sl\sa0 \plain\f1\fntnamaut Verse 3\par
\li0\fi0\ri0\sb0\sl\sa0 \plain\f1\fntnamaut I need Thy presence\par
\li0\fi0\ri0\sb0\sl\sa0 \plain\f1\fntnamaut Every passing hour.\par
\li0\fi0\ri0\sb0\sl\sa0 \plain\f1\fntnamaut What but Thy grace\par
\li0\fi0\ri0\sb0\sl\sa0 \plain\f1\fntnamaut Can foil the tempter's power?\par
\li0\fi0\ri0\sb0\sl\sa0 \plain\f1\fntnamaut Who, like Thyself,\par
\li0\fi0\ri0\sb0\sl\sa0 \plain\f1\fntnamaut My guide and stay can be?\par
\li0\fi0\ri0\sb0\sl\sa0 \plain\f1\fntnamaut Through cloud and sunshine,\par
\li0\fi0\ri0\sb0\sl\sa0 \plain\f1\fntnamaut Lord, abide with me. \par
\li0\fi0\ri0\sb0\sl\sa0 \par
\li0\fi0\ri0\sb0\sl\sa0 \plain\f1\fntnamaut Verse 4\par
\li0\fi0\ri0\sb0\sl\sa0 \plain\f1\fntnamaut I fear no foe,\par
\li0\fi0\ri0\sb0\sl\sa0 \plain\f1\fntnamaut With Thee at hand to bless;\par
\li0\fi0\ri0\sb0\sl\sa0 \plain\f1\fntnamaut Ills have no weight,\par
\li0\fi0\ri0\sb0\sl\sa0 \plain\f1\fntnamaut And tears no bitterness.\par
\li0\fi0\ri0\sb0\sl\sa0 \plain\f1\fntnamaut Where is death's sting?\par
\li0\fi0\ri0\sb0\sl\sa0 \plain\f1\fntnamaut Where, grave, thy victory?\par
\li0\fi0\ri0\sb0\sl\sa0 \plain\f1\fntnamaut I triumph still,\par
\li0\fi0\ri0\sb0\sl\sa0 \plain\f1\fntnamaut If Thou abide with me. \par
\li0\fi0\ri0\sb0\sl\sa0 \par
\li0\fi0\ri0\sb0\sl\sa0 \plain\f1\fntnamaut Verse 5\par
\li0\fi0\ri0\sb0\sl\sa0 \plain\f1\fntnamaut Hold Thou Thy cross\par
\li0\fi0\ri0\sb0\sl\sa0 \plain\f1\fntnamaut Before my closing eyes;\par
\li0\fi0\ri0\sb0\sl\sa0 \plain\f1\fntnamaut Shine through the gloom\par
\li0\fi0\ri0\sb0\sl\sa0 \plain\f1\fntnamaut And point me to the skies.\par
\li0\fi0\ri0\sb0\sl\sa0 \plain\f1\fntnamaut Heaven's morning breaks,\par
\li0\fi0\ri0\sb0\sl\sa0 \plain\f1\fntnamaut And earth's vain shadows flee!\par
\li0\fi0\ri0\sb0\sl\sa0 \plain\f1\fntnamaut In life, in death,\par
\li0\fi0\ri0\sb0\sl\sa0 \plain\f1\fntnamaut O Lord, abide with me!}
}